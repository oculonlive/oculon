# All optional. Oculon runs with no keys at all; each key switches on more sources.
# Every listed service has a free tier, except the optional pay-per-use block below.

# --- Core ---
OCULON_HOME=                 # data folder (database + images), default ~/.oculon
OCULON_DB=                   # database path override
OCULON_CONTACT=              # contact email; sent only to SEC EDGAR (required there), never to other APIs
GITHUB_TOKEN=                # GitHub: 60 -> 5000 requests/hour

# --- AI agent (`oculon ask`), tried in this order ---
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=              # NVIDIA NIM developer key (free credits), build.nvidia.com
OPENROUTER_API_KEY=           # also powers the /ask analyst (Claude Haiku 5.5, Claude Opus 5.5, GPT-6.2 Astra)
OCULON_ANALYST_PER_HOUR=      # questions per visitor per hour on a public install, default 40

# --- Optional pay-per-use (no subscription; each has a daily call budget in Oculon) ---
ANTHROPIC_API_KEY=           # Claude for ask, cases, brief, contradictions; free tiers stay the fallback
OCULON_CLAUDE_MODEL=         # default claude-opus-5-5
OCULON_CLAUDE_DEEP_MODEL=    # default claude-fable-5-2, used by case investigations
OCULON_QUOTA_ANTHROPIC=      # Claude calls per day, default 150
APIFY_TOKEN=                 # X, Reddit and TikTok search for `oculon social` (free plan: $5 credit/month)
OCULON_QUOTA_APIFY=          # Apify actor runs per day, default 40
DEEPGRAM_API_KEY=            # transcription for `oculon podcast` / `listen` (free starting credit)
OCULON_QUOTA_DEEPGRAM=       # transcriptions per day, default 30

# --- Free keys for the outage / hazard / maritime layer ---
CLOUDFLARE_API_TOKEN=        # Cloudflare Radar (custom token template "Read Cloudflare Radar data")
GFW_API_TOKEN=               # Global Fishing Watch (free non-commercial token): dark ships, vessel identity
COPERNICUS_CLIENT_ID=        # Copernicus Data Space OAuth client (free): Sentinel-2 10 m and Sentinel-1 radar images
COPERNICUS_CLIENT_SECRET=
FIRMS_MAP_KEY=               # NASA FIRMS (free, emailed): active fires
OPENSANCTIONS_API_KEY=       # OpenSanctions (free non-commercial): worldwide sanctions, PEPs, wanted lists
NASA_API_KEY=                # api.nasa.gov (free, instant): DONKI space weather and asteroid passes; DEMO_KEY otherwise

# --- Web search and page reading ---
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# --- News ---
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=

# --- Markets ---
FINNHUB_API_KEY=             # quotes, insider transactions, company news
FRED_API_KEY=
COINGECKO_API_KEY=           # demo key

# --- On-chain ---
ZERION_API_KEY=
ETHERSCAN_API_KEY=
WEBACY_API_KEY=
HELIUS_API_KEY=              # Solana
ROBINHOOD_PUBLIC_RPC_URL=

# --- Companies ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=              # job openings
COURTLISTENER_TOKEN=         # US federal dockets
COMPANIES_HOUSE_API_KEY=     # UK registry
BRANDFETCH_API_KEY=

# --- Web security and fact checks ---
URLSCAN_API_KEY=             # urlscan.io scan history (free account)
SAFE_BROWSING_KEY=           # Google Safe Browsing (free, non-commercial)
ABUSECH_AUTH_KEY=            # URLhaus, MalwareBazaar, ThreatFox (free at auth.abuse.ch)

# --- Threat intel and phone (oculon ip, hash, phone) ---
ABUSEIPDB_API_KEY=           # abuse reports per IP (free, 1,000/day)
OTX_API_KEY=                 # AlienVault OTX threat reports (free)
IPINFO_TOKEN=                # IPinfo Lite: ASN and country (free, 50,000/month)
VIRUSTOTAL_API_KEY=          # VirusTotal (free public API, non-commercial, 500/day)
NUMVERIFY_API_KEY=           # phone line type and carrier (free, 100/month)
GOOGLE_API_KEY=              # Google Fact Check Tools (free; can be the same key as Safe Browsing)

# --- Social and research ---
YOUTUBE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
OPENALEX_API_KEY=

# --- Air quality ---
OPENAQ_API_KEY=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=      # comma-separated chat ids
TELEGRAM_ALERT_MIN_SCORE=70
TELEGRAM_WATCH_MINUTES=15

# Wallet safety, pages and files (all free)
BLOCKSCOUT_API_KEY=
ALCHEMY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
HYBRID_ANALYSIS_KEY=
CHAINABUSE_API_KEY=
