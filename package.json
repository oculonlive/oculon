{
  "name": "oculon",
  "version": "0.1.3",
  "description": "OSINT engine you can run, script and plug into agents: 70+ live tools for scams, links, outages, CVEs and research, each result with its sources. CLI, SDK, MCP server and web app. Zero dependencies.",
  "keywords": [
    "osint",
    "open-source-intelligence",
    "mcp",
    "mcp-server",
    "ai-agent",
    "cli",
    "scam-detection",
    "fact-checking",
    "outage-monitoring",
    "cve",
    "threat-intelligence",
    "bgp",
    "research"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "oculon": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "oculon": "node --import tsx src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "homepage": "https://oculon.live",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oculonlive/oculon.git"
  },
  "bugs": {
    "url": "https://github.com/oculonlive/oculon/issues"
  }
}
